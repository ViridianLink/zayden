
# Required
AI_PROVIDER_KEY="your-ai-provider-key"
BUNGIE_API_KEY="your-bungie-api-key"
DATABASE_URL="postgresql://user:password@host:5432/zayden"
DISCORD_CLIENT_SECRET="your-discord-oauth-client-secret"
DISCORD_TOKEN="your-discord-bot-token"
GOOGLE_API_KEY="your-google-api-key"
KOFI_VERIFICATION_TOKEN="your-kofi-webhook-verification-token"

# Optional
# ERROR_LOG_WEBHOOK="https://discord.com/api/webhooks/<id>/<token>"
# NORMAL_LOG_WEBHOOK="https://discord.com/api/webhooks/<id>/<token>"

# FLARESOLVERR_URL="http://127.0.0.1:8191/v1"

# YOUTUBE_COOKIES_FILE="/app/secrets/youtube-cookies.txt"

# PELICAN_BASE_URL="http://127.0.0.1"
# PELICAN_API_KEY="ptlc_your-client-api-key"

# PATREON_CLIENT_ID="your-patreon-client-id"
# PATREON_CLIENT_SECRET="your-patreon-client-secret"

# SPOTIFY_CLIENT_ID="your-spotify-client-id"
# SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"

# Jellyfin / Jellyseerr. All six must be set together or /jellyfin and /watch
# stay disabled. The library ids scope the index to the two real libraries; a
# bare recursive query also walks the per-user "Recommended" virtual libraries.
# JELLYFIN_BASE_URL="https://jellyfin.example.com"
# JELLYFIN_API_KEY="your-jellyfin-api-key"
# JELLYFIN_MOVIE_LIBRARY_ID="your-movies-library-id"
# JELLYFIN_SHOW_LIBRARY_ID="your-shows-library-id"
# JELLYSEERR_BASE_URL="https://seer.example.com"
# JELLYSEERR_API_KEY="your-jellyseerr-api-key"

# Optional: without it /watch warnings self-disables.
# DOESTHEDOGDIE_API_KEY="your-doesthedogdie-api-key"
