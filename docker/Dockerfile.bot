FROM rust:1-slim-trixie AS chef
ENV RUSTUP_TOOLCHAIN=stable
WORKDIR /app
RUN cargo install cargo-chef --locked

# Stage 1: plan
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 2: build
FROM chef AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake clang libclang-dev nasm perl \
    pkg-config libssl-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV SQLX_OFFLINE=true

COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json --bin bot

COPY . .
RUN cargo build --release --bin bot

# Stage 3: fetch yt-dlp
FROM debian:trixie-slim AS ytdlp
ARG YTDLP_VERSION=2026.07.04
ARG DENO_VERSION=v2.9.5

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    base="https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}"; \
    curl -fsSL "$base/yt-dlp_linux" -o /yt-dlp; \
    curl -fsSL "$base/SHA2-256SUMS" -o /SHA2-256SUMS; \
    expected="$(awk '$2 == "yt-dlp_linux" { print $1 }' /SHA2-256SUMS)"; \
    test -n "$expected"; \
    echo "${expected}  /yt-dlp" | sha256sum -c -; \
    rm /SHA2-256SUMS; \
    chmod a+rx /yt-dlp

# x86_64 only, matching the `yt-dlp_linux` build fetched above.
RUN set -eux; \
    asset="deno-x86_64-unknown-linux-gnu.zip"; \
    base="https://github.com/denoland/deno/releases/download/${DENO_VERSION}"; \
    curl -fsSL "$base/$asset" -o "/$asset"; \
    curl -fsSL "$base/${asset}.sha256sum" -o /deno.sha256sum; \
    expected="$(awk '{ print $1 }' /deno.sha256sum)"; \
    test -n "$expected"; \
    echo "${expected}  /$asset" | sha256sum -c -; \
    unzip -q "/$asset" -d /; \
    rm "/$asset" /deno.sha256sum; \
    chmod a+rx /deno

# Stage 4: runtime
FROM debian:trixie-slim AS runtime
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 ffmpeg \
    fonts-noto-core fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ytdlp /yt-dlp /usr/local/bin/yt-dlp
COPY --from=ytdlp /deno /usr/local/bin/deno
RUN yt-dlp --version && deno --version

ENV DENO_DIR=/app/.deno

RUN groupadd --system zayden && useradd --system --gid zayden zayden \
    && mkdir -p /app/palworld_uploads /app/.deno \
    && chown -R zayden:zayden /app

COPY --from=builder /app/target/release/bot /usr/local/bin/zayden-bot

USER zayden
ENTRYPOINT ["zayden-bot"]
