  "query": "\n            SELECT a.guild_id, a.channel_id, a.public_only\n            FROM patreon_announce a\n            JOIN patreon_oauth o ON o.guild_id = a.guild_id\n            WHERE o.campaign_id = $1\n              AND o.disabled_at IS NULL\n              AND (NOT a.public_only OR $2)\n            ",
