{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT o.guild_id,\n                   o.channel_id,\n                   c.title AS channel_title,\n                   COALESCE(c.websub_expires_at > now(), FALSE) AS \"lease_active!\"\n            FROM youtube_connections o\n            JOIN youtube_channels c ON c.channel_id = o.channel_id\n            WHERE o.guild_id = $1\n            ",
