  "query": "SELECT\n    g.user_id,\n    g.coins,\n    i.quantity AS quantity\nFROM\n    gambling g\n    LEFT JOIN gambling_inventory i ON g.user_id = i.user_id\n        AND i.item_id = $1\nWHERE\n    i.quantity > 0\n",
