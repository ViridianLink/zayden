  "query": "INSERT INTO destiny2_weapons (name, affinity, archetype, icon_url)\n             VALUES ($1, $2, $3, $4)\n             ON CONFLICT (name) DO UPDATE SET\n                affinity = EXCLUDED.affinity,\n                archetype = EXCLUDED.archetype,\n                icon_url = EXCLUDED.icon_url\n             RETURNING id",
