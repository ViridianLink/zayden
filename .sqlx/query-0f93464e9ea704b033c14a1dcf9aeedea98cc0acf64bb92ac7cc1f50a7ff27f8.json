  "query": "\n            INSERT INTO greetings_settings (\n                guild_id, morning_message, night_message\n            )\n            VALUES ($1, $2, $3)\n            ON CONFLICT (guild_id) DO UPDATE SET\n                morning_message = EXCLUDED.morning_message,\n                night_message = EXCLUDED.night_message,\n                updated_at = now()\n            RETURNING\n                guild_id,\n                morning_message,\n                night_message\n            ",
