  "query": "\n        SELECT p.account_id,\n               p.discord_id,\n               p.badge,\n               p.streak,\n               p.announced_streak\n        FROM deadlock_players p\n        WHERE EXISTS (\n            SELECT 1 FROM deadlock_guild_members m\n            WHERE m.discord_id = p.discord_id AND m.squad\n        )\n        ORDER BY p.account_id\n        ",
