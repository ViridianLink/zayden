  "query": "\n            SELECT user_id,\n                   SUM(points)::int AS \"points!\",\n                   SUM(correct)::int AS \"correct!\",\n                   SUM(played)::int AS \"played!\"\n            FROM jellyfin_game_scores\n            WHERE guild_id = $1 AND ($2::text IS NULL OR game = $2)\n            GROUP BY user_id\n            ORDER BY \"points!\" DESC\n            LIMIT $3\n            ",
